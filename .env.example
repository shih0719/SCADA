# Copy to .env and adjust for this machine. Used by `npm run build` and `npm start`.

# ---- Runtime (read by `npm start`; restart to apply) ----
# Address/port the server listens on. 0.0.0.0 = reachable from other machines on the LAN.
HOST=0.0.0.0
PORT=3000
# Max request body. Floorplans can be up to 10MB and a backup .zip holds every
# floorplan, so the 512K default is far too small.
BODY_SIZE_LIMIT=200M
# debug | info | warn | error  (written to console and data/app.log)
LOG_LEVEL=info

# ---- Build time (read by `npm run build`; rebuild to apply) ----
# Every address operators type into the browser, comma-separated, with protocol
# and port. Uploads and backup restore are rejected (403) from any other address.
TRUSTED_ORIGINS=http://localhost:3000,http://192.168.1.10:3000
